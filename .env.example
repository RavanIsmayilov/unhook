# --- Gemini (default analyzer; supports images) ---  https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Groq (default attacker; text-only fallback for the analyzer) ---  https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# When a model is rate-limited, try these next (free quotas are per model). Comma-separated, may be empty.
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b

# Which provider does what: gemini | groq
ANALYZER_PROVIDER=groq
ATTACKER_PROVIDER=groq
# Optional: use a different model for the attacker than for the analyzer (a different family tests it harder)
ATTACKER_MODEL=qwen/qwen3.8-27b

# Seconds to wait between LLM calls in eval.py / attacker.py (free-tier rate limits)
CALL_DELAY_SECONDS=4

# --- Telegram ---  talk to @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=

# Which websites may call the API from a browser (comma-separated). *.vercel.app previews are allowed by default.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DATABASE_URL=sqlite:///unhook.db
